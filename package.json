{
  "private": true,
  "name": "@bchatsign/root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "2.20.0",
  "scripts": {
    "postinstall": "patch-package",
    "build": "turbo run build",
    "dev": "npm run translate:compile && turbo run dev --filter=@bchatsign/remix",
    "dev:remix": "npm run translate:compile && turbo run dev --filter=@bchatsign/remix",
    "dev:docs": "turbo run dev --filter=@bchatsign/docs",
    "dev:openpage-api": "turbo run dev --filter=@bchatsign/openpage-api",
    "start": "turbo run start --filter=@bchatsign/remix --filter=@bchatsign/docs --filter=@bchatsign/openpage-api",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --write --no-errors-on-unmatched",
    "format": "biome format --write .",
    "clean": "turbo run clean && rimraf node_modules",
    "d": "npm run dx && npm run translate:compile && npm run dev",
    "dx": "npm ci && npm run dx:up && npm run prisma:migrate-dev && npm run prisma:seed",
    "dx:up": "docker compose -f docker/development/compose.yml up -d",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "ci": "turbo run build --filter=@bchatsign/remix && turbo run test:e2e",
    "prisma:generate": "npm run with:env -- npm run prisma:generate -w @bchatsign/prisma",
    "prisma:migrate-dev": "npm run with:env -- npm run prisma:migrate-dev -w @bchatsign/prisma",
    "prisma:migrate-deploy": "npm run with:env -- npm run prisma:migrate-deploy -w @bchatsign/prisma",
    "prisma:migrate-reset": "npm run with:env -- npm run prisma:migrate-reset -w @bchatsign/prisma",
    "prisma:seed": "npm run with:env -- npm run prisma:seed -w @bchatsign/prisma",
    "prisma:studio": "npm run with:env -- npm run prisma:studio -w @bchatsign/prisma",
    "with:env": "dotenv -e .env -e .env.local --",
    "reset:hard": "npm run clean && npm i && npm run prisma:generate",
    "precommit": "npm install && git add package.json package-lock.json",
    "inngest:dev": "inngest dev -u http://localhost:3000/api/jobs",
    "make:version": "npm version --workspace @bchatsign/remix --include-workspace-root --no-git-tag-version -m \"v%s\"",
    "translate": "npm run translate:extract && npm run translate:compile",
    "translate:extract": "lingui extract --clean",
    "translate:compile": "lingui compile",
    "push": "./scripts/build-and-push-ghcr.sh",
    "push:ghcr": "./scripts/build-and-push-ghcr.sh",
    "deploy:dev": "bash scripts/deployportainer.sh dev",
    "deploy:prod": "bash scripts/deployportainer.sh prod",
    "deploy:stack": "bash scripts/deployportainer.sh"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "npm": ">=11.17.0",
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "skia-canvas": true,
    "@playwright/browser-chromium": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "aws-crt": true,
    "esbuild": true,
    "fsevents": true,
    "inngest-cli": true,
    "prisma": true,
    "@datadog/pprof": false,
    "core-js": false,
    "msgpackr-extract": false,
    "protobufjs": false
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@datadog/pprof": "^5.13.5",
    "skia-canvas": "^3.0.8",
    "@lingui/cli": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@trpc/client": "11.17.0",
    "@trpc/react-query": "11.17.0",
    "@trpc/server": "11.17.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "inngest": "^3.54.0",
    "inngest-cli": "^1.44.0",
    "lint-staged": "^16.2.7",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.0.6",
    "pdfjs-dist": "5.4.296",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "playwright": "1.56.1",
    "prisma": "^6.19.0",
    "prisma-extension-kysely": "^3.0.0",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-kysely": "^2.3.0",
    "rimraf": "^6.1.2",
    "superjson": "^2.2.5",
    "syncpack": "^14.0.0-alpha.27",
    "turbo": "^2.10.0",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "zod-openapi": "^4.2.4",
    "zod-prisma-types": "3.3.5"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.48",
    "@bchatsign/prisma": "*",
    "@libpdf/core": "^0.5.2",
    "@lingui/conf": "^5.6.0",
    "@lingui/core": "^5.6.0",
    "@marsidev/react-turnstile": "^1.5.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "ai": "^7.0.58",
    "cron-parser": "^5.5.0",
    "fflate": "^0.8.3",
    "luxon": "^3.7.2",
    "patch-package": "^8.0.1",
    "posthog-node": "4.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.5",
    "skia-canvas": "^3.0.8",
    "typescript": "5.6.2",
    "zod": "^3.25.76"
  },
  "overrides": {
    "lodash": "4.18.1",
    "brace-expansion@1": "^1.1.18",
    "pdfjs-dist": "5.4.296",
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.6.2",
    "zod": "$zod",
    "fumadocs-mdx": {
      "zod": "^4.3.5"
    },
    "brace-expansion@1.x": "1.1.20",
    "brace-expansion@2.x": "2.1.6",
    "brace-expansion@5.x": "5.0.11",
    "browserslist": "4.28.7",
    "js-yaml@3.x": "3.15.2",
    "js-yaml@4.x": "4.3.2",
    "nanoid@3.x": "3.3.18",
    "postcss": "8.5.19",
    "engine.io": "6.6.10",
    "fast-uri@3.x": "3.1.7",
    "compression": "1.8.2",
    "source-map-js": "1.2.2",
    "proxy-addr": "2.0.8",
    "joi": "18.2.6",
    "form-data": "4.0.6",
    "protobufjs": "7.6.1",
    "socket.io-parser": "4.2.7",
    "tmp": "0.2.7",
    "image-size": "2.0.4",
    "deepmerge-ts": "8.0.0",
    "ws@7.x": "7.5.11",
    "ws@8.x": "8.21.0",
    "socket.io-adapter": {
      "ws": "8.21.0"
    },
    "axios": "1.20.0",
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/propagator-jaeger": "2.9.0"
  }
}
